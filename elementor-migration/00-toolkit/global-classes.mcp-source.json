{
  "purpose": "MCP-ready source operations for Elementor elementor/manage-classes",
  "mode": "create",
  "operations": [
    {
      "action": "create",
      "label": "vsn-container",
      "css": "width:100%;max-width:1240px;margin-left:auto;margin-right:auto;padding-left:20px;padding-right:20px;@media(--mobile){padding-left:14px;padding-right:14px;}"
    },
    {
      "action": "create",
      "label": "vsn-section",
      "css": "padding-top:112px;padding-bottom:112px;@media(--tablet){padding-top:80px;padding-bottom:80px;}@media(--mobile){padding-top:64px;padding-bottom:64px;}"
    },
    {
      "action": "create",
      "label": "vsn-section-tight",
      "css": "padding-top:72px;padding-bottom:72px;@media(--tablet){padding-top:56px;padding-bottom:56px;}@media(--mobile){padding-top:44px;padding-bottom:44px;}"
    },
    {
      "action": "create",
      "label": "vsn-section-soft",
      "css": "background-color:var(--vsn-white);border-top:1px solid var(--vsn-line);"
    },
    {
      "action": "create",
      "label": "vsn-grid-2",
      "css": "display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px;@media(--tablet){gap:24px;}@media(--mobile){grid-template-columns:1fr;gap:20px;}"
    },
    {
      "action": "create",
      "label": "vsn-grid-3",
      "css": "display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;@media(--tablet){grid-template-columns:repeat(2,minmax(0,1fr));}@media(--mobile){grid-template-columns:1fr;}"
    },
    {
      "action": "create",
      "label": "vsn-grid-4",
      "css": "display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;@media(--tablet){grid-template-columns:repeat(2,minmax(0,1fr));}@media(--mobile){grid-template-columns:1fr;}"
    },
    {
      "action": "create",
      "label": "vsn-display-xl",
      "css": "font-family:Inter;font-size:clamp(68px,7.7vw,112px);font-weight:850;line-height:.92;letter-spacing:-.06em;color:var(--vsn-black);@media(--mobile){font-size:clamp(48px,14vw,70px);line-height:.94;}"
    },
    {
      "action": "create",
      "label": "vsn-display-service",
      "css": "font-family:Inter;font-size:clamp(54px,6.1vw,98px);font-weight:850;line-height:.92;letter-spacing:-.068em;color:var(--vsn-black);@media(--mobile){font-size:clamp(46px,13.5vw,70px);line-height:.95;}"
    },
    {
      "action": "create",
      "label": "vsn-h2",
      "css": "font-family:Inter;font-size:clamp(44px,5vw,76px);font-weight:850;line-height:.98;letter-spacing:-.052em;color:var(--vsn-black);@media(--mobile){font-size:clamp(36px,10vw,52px);}"
    },
    {
      "action": "create",
      "label": "vsn-h3",
      "css": "font-family:Inter;font-size:28px;font-weight:800;line-height:1.08;letter-spacing:-.035em;color:var(--vsn-black);@media(--mobile){font-size:24px;}"
    },
    {
      "action": "create",
      "label": "vsn-body-lg",
      "css": "font-family:Inter;font-size:20px;font-weight:400;line-height:1.55;letter-spacing:-.01em;color:var(--vsn-charcoal);@media(--mobile){font-size:18px;}"
    },
    {
      "action": "create",
      "label": "vsn-eyebrow",
      "css": "font-family:Inter;font-size:12px;font-weight:700;line-height:1.3;letter-spacing:.1em;text-transform:uppercase;color:var(--vsn-muted);"
    },
    {
      "action": "create",
      "label": "vsn-btn",
      "css": "display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:14px 20px;border-radius:14px;font-family:Inter;font-weight:800;text-decoration:none;transition:transform 200ms cubic-bezier(.22,1,.36,1),box-shadow 200ms cubic-bezier(.22,1,.36,1),background-color 200ms cubic-bezier(.22,1,.36,1),color 200ms cubic-bezier(.22,1,.36,1);&:hover{transform:translateY(-2px);}&:focus{outline:2px solid var(--vsn-blue);outline-offset:3px;}"
    },
    {
      "action": "create",
      "label": "vsn-btn-primary",
      "css": "background-color:var(--vsn-black);color:var(--vsn-white);border:1px solid var(--vsn-black);&:hover{background-color:var(--vsn-charcoal);}"
    },
    {
      "action": "create",
      "label": "vsn-btn-brand",
      "css": "background-color:var(--vsn-cyan);color:var(--vsn-black);border:1px solid var(--vsn-cyan);&:hover{background-color:var(--vsn-blue);color:var(--vsn-white);}"
    },
    {
      "action": "create",
      "label": "vsn-btn-outline",
      "css": "background-color:transparent;color:var(--vsn-black);border:1px solid var(--vsn-charcoal);&:hover{background-color:var(--vsn-black);color:var(--vsn-white);}"
    },
    {
      "action": "create",
      "label": "vsn-card",
      "css": "background-color:var(--vsn-white);border:1px solid var(--vsn-line);border-radius:20px;padding:28px;box-shadow:0 20px 52px rgba(0,0,0,.08);transition:transform 220ms cubic-bezier(.22,1,.36,1),box-shadow 220ms cubic-bezier(.22,1,.36,1);&:hover{transform:translateY(-4px);box-shadow:0 26px 64px rgba(0,0,0,.12);}@media(--mobile){padding:22px;}"
    },
    {
      "action": "create",
      "label": "vsn-card-dark",
      "css": "background-color:var(--vsn-black);color:var(--vsn-white);border:1px solid var(--vsn-black);border-radius:20px;padding:28px;@media(--mobile){padding:22px;}"
    },
    {
      "action": "create",
      "label": "vsn-media-frame",
      "css": "overflow:hidden;border-radius:24px;background-color:var(--vsn-white);border:1px solid var(--vsn-line);"
    },
    {
      "action": "create",
      "label": "vsn-form-field",
      "css": "width:100%;min-height:48px;background-color:var(--vsn-white);color:var(--vsn-black);border:1px solid var(--vsn-line);border-radius:10px;padding:13px 14px;font-family:Inter;font-size:16px;line-height:1.5;&:focus{border-color:var(--vsn-blue);outline:2px solid rgba(97,136,198,.18);outline-offset:1px;}"
    },
    {
      "action": "create",
      "label": "vsn-hover-lift",
      "css": "transition:transform 220ms cubic-bezier(.22,1,.36,1);&:hover{transform:translateY(-4px);}"
    },
    {
      "action": "create",
      "label": "vsn-divider-top",
      "css": "border-top:1px solid var(--vsn-line);padding-top:42px;@media(--mobile){padding-top:30px;}"
    },
    {
      "action": "create",
      "label": "vsn-content-narrow",
      "css": "width:100%;max-width:820px;margin-left:auto;margin-right:auto;"
    },
    {
      "action": "create",
      "label": "vsn-content-reading",
      "css": "width:100%;max-width:920px;margin-left:auto;margin-right:auto;"
    }
  ]
}